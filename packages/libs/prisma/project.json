{
  "name": "prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/libs/prisma/src",
  "projectType": "library",
  "targets": {
    "generate-client": {
      "command": "prisma generate --schema=packages/libs/prisma/prisma/schema.prisma"
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["generate-client"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/libs/prisma",
        "main": "packages/libs/prisma/src/index.ts",
        "tsConfig": "packages/libs/prisma/tsconfig.lib.json",
        "assets": [
          "packages/libs/prisma/*.md",
          {
            "glob": "**/*",
            "input": "packages/libs/prisma/src/lib/generated",
            "output": "src/lib/generated"
          }
        ]
      }
    }
  },
  "tags": []
}
