{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
     "allowSyntheticDefaultImports": true,
    "esModuleInterop": true ,
    
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {

      "@apps/utils": ["apps/utils/index.ts"],
      "@apps/utils/*": ["apps/utils/*"],

      "@packages/error-handler": ["packages/error-handler/src/index.ts"],
      "@packages/middleware": ["packages/middleware/src/index.ts"],
      "@packages/kafka": ["packages/utils/kafka/index.ts"],
      "@packages/prisma": ["packages/libs/prisma/src/index.ts"],
      "@packages/redis": ["packages/libs/redis/src/index.ts"],
      "@packages/imagekit": ["packages/libs/imagekit/src/index.ts"],
      
      "@packages/utils": ["packages/utils/src/index.tsx"],

      "@seller-ui/*": ["apps/seller-ui/src/*"],
      "@user-ui/*": ["apps/user-ui/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"],

  "include": [
    "packages/utils/src/global.d.ts" // 👈 Add this relative path
  ]
}
