{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["node"],
    "paths": {
      "@apps/*": ["/apps/*"],
      "@apps/utils/*": ["apps/utils/*"],
      "@seller-ui/*": ["apps/seller-ui/src/*"],
      "@user-ui/*": ["apps/user-ui/src/*"],
      "packages": ["packages/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
