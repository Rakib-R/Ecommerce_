{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["node"],
    "paths": {
      "@apps/utils/*": ["apps/utils/*"],
      "@packages/kafka": ["packages/utils/kafka/index.ts"],
      "@packages/prisma": ["packages/libs/prisma/src/lib/prisma.ts"],
      "@seller-ui/*": ["apps/seller-ui/src/*"],
      "@user-ui/*": ["apps/user-ui/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
