{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,

    "allowJs": true,
    "declaration": false,

    "baseUrl": ".",
    "paths": {
      "@app/auth-types": ["apps/auth-service/src/auth/index.ts"],
      "@seller-ui/*": ["apps/seller-ui/src/*"],
      "@user-ui/*": ["apps/user-ui/src/*"],
      "@packages/auth-types": ["packages/auth-types/src/lib/auth-types.ts"],

      "@packages/error-handler": ["packages/error-handler/src/index.ts"],
      "@packages/validationError": ["packages/error-handler/src/index.ts"],
      "@packages/NotFoundError": ["packages/error-handler/src/index.ts"],
      "@packages/ForbiddenError": ["packages/error-handler/src/index.ts"],
      "@packages/AuthError": ["packages/error-handler/src/index.ts"],

      "@packages/imagekit": ["packages/libs/imagekit/src/index.ts"],
      "@packages/kafka": ["packages/utils/kafka/index.ts"],
      "@packages/middleware": ["packages/middleware/src/index.ts"],
      "@packages/prisma": ["packages/libs/prisma/src/index.ts"],
      "@packages/components": ["packages/components/index.ts"],
      "@packages/redis": ["packages/libs/redis/src/index.ts"],
      "@packages/utils": ["packages/utils/src/index.tsx"]
    }
  },
  "exclude": ["node_modules", "tmp"],
  "include": ["packages/utils/src/global.d.ts"]
}
