{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,

    /* Modern Bundler Settings */
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    /* Interop & Safety */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    /* Decorators (Keep if your Nx libs require them) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,

    "baseUrl": ".",
    "paths": {
      "@apps/utils": ["apps/utils/index.ts"],
      "@apps/utils/*": ["apps/utils/*"],
      "@packages/error-handler": ["packages/error-handler/src/index.ts"],
      "@packages/kafka": ["packages/utils/kafka/index.ts"],
      "@packages/prisma": ["packages/libs/prisma/src/index.ts"],
      "@packages/components": ["packages/components"],
      "@packages/redis": ["packages/libs/redis/src/index.ts"],
      "@packages/imagekit": ["packages/libs/imagekit/src/index.ts"],
      "@packages/utils": ["packages/utils/src/index.ts"],
      "@seller-ui/*": ["apps/seller-ui/src/*"],
      "@user-ui/*": ["apps/user-ui/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"],
  "include": ["packages/utils/src/global.d.ts"]
}
