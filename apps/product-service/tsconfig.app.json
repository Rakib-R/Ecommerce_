{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "outDir": "../../dist/out-tsc",
    "rootDir": ".",          // ← ADD THIS
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "express"]
  },
  "include": [
    "src/**/*.ts",
    "schema/**/*.ts",             // ← ADD THIS (you have schema folder outside src)
  ],
  "exclude": [
    "../../node_modules"
  ]
}