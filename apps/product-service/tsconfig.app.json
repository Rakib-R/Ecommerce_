{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,  //todo ==->> REAL FIX, NO MORE CHECKING FOR BUILD OUTPUTS!
    "ignoreDeprecations": "6.0",
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "express"],
  },
  "include": [
    "src/**/*.ts",
    "src/swagger.ts"
  ]
}