{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "ignoreDeprecations": "5.0",
    // "outDir": "../../dist/out-tsc/apps/product-service",
    // "rootDir": ".",          // ← ADD THIS
    "moduleResolution": "node",
    "target": "es2020",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "express"]
  },
  "include": [
    "src/**/*.ts",
    "schema/**/*.ts",             // ← ADD THIS (you have schema folder outside src)
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
]

}