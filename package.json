{
  "name": "ecommerce-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm exec nx run-many --target=serve --all",
    "dev:backend": "pnpm exec nx run-many --target=serve --projects=api-gateway,auth-service,api",
    "dev:frontend": "pnpm exec nx run-many --target=serve --projects=seller-ui,user-ui",
    "product": "pnpm exec nx serve product-service",
    "kafka": "pnpm exec nx serve kafka-service",
    "prisma:generate": "pnpm --filter @packages/prisma exec prisma generate --schema=prisma/schema.prisma",
    "start:prod": "pnpm exec nx run-many --target=serve --all --prod",
    "lint": "next lint",
    "build:analyze_user": "cross-env ANALYZE=true pnpm exec nx build user-ui",
    "build:analyze_seller": "cross-env ANALYZE=true pnpm exec nx build seller-ui",
    "build": "pnpm exec nx run-many --target=build --all",
    "product-docs": "node apps/product-service/src/swagger.js",
    "auth-docs": "node apps/auth-service/src/swagger.js",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.33.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32"
      ],
      "cpu": [
        "x64"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/core",
        "webpack"
      ]
    },
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "esbuild",
      "@swc/core",
      "sharp"
    ]
  },
  "overrides": {
    "prisma": "6.5.0",
    "@prisma/client": "6.5.0"
  },
  "prisma": {
    "schema": "packages/libs/prisma/prisma/schema.prisma"
  },
  "THIS IS COMMENTED OUT": {
    "nx": {
      "targets": {
        "build": {},
        "serve": {
          "dependsOn": [
            "^build"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "^9.8.0",
    "@next/bundle-analyzer": "16.2.2",
    "@nx/devkit": "20.8.4",
    "@nx/eslint": "20.8.4",
    "@nx/eslint-plugin": "20.8.4",
    "@nx/express": "20.8.4",
    "@nx/jest": "20.8.4",
    "@nx/js": "20.8.4",
    "@nx/next": "^20.8.4",
