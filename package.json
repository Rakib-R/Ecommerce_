    "@nx/workspace": "20.8.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.5",
    "@swc/helpers": "0.5.18",
    "@types/cookie-parser": "^1.4.10",
